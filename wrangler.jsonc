{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "river-strike",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "river-strike-scores",
      "database_id": "3313fbd1-2319-4c98-a8d3-601a3cc015dc",
      "migrations_dir": "drizzle"
    }
  ]
}
